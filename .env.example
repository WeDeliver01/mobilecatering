# Local embedded Postgres (PGlite) data directory. No external services needed to run locally.
PGLITE_DIR=./data/pg

# Local payment-webhook test token. Use a strong secret in production.
# PAYFAST_WEBHOOK_TOKEN=replace-with-a-long-random-secret

# --- Admin auth (required to use /admin) ---
# Shared password for the single admin login at /admin/login. Use a strong,
# unique value in production — this is the only gate in front of the dashboard.
# ADMIN_PASSWORD=replace-with-a-strong-password
#
# Secret used to sign admin session cookies. Generate with: openssl rand -hex 32
# SESSION_SECRET=replace-with-a-long-random-secret

# --- Address autocomplete & distance-based delivery pricing (optional) ---
# Get a free-tier key at https://www.geoapify.com/. Without it, the address
# field still works as plain manual entry and delivery is charged a flat
# base fee (src/lib/pricing.ts) instead of real distance from the depot.
# Server-side only — never exposed to the browser (see src/app/api/geocode).
# GEOAPIFY_API_KEY=replace-with-your-geoapify-key

# --- For external hosting later (Supabase / any Postgres) ---
# The Drizzle schema is standard Postgres, so hosting is a driver swap in src/db/client.ts.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
