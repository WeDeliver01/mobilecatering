# Local embedded Postgres (PGlite) data directory. No external services needed to run locally.
PGLITE_DIR=./data/pg

# --- Payment gateways (all optional; manual EFT always works with no setup) ---
# Public base URL used to build checkout return/webhook URLs and links in
# emails. Set this to the real deployed domain in production.
# NEXT_PUBLIC_SITE_URL=https://catering.operandis.co.za
#
# BobPay (primary). Webhook: /api/payments/webhook/bobpay
# BOBPAY_API_KEY=replace-with-your-bobpay-api-key-or-jwt
# BOBPAY_ENV=sandbox               # "sandbox" (default) or "production"
# BOBPAY_WEBHOOK_SECRET=replace-with-your-bobpay-webhook-secret
# BOBPAY_WEBHOOK_ALLOWED_IPS=      # optional comma-separated IP allowlist
#
# Yoco (secondary). Webhook: /api/payments/webhook/yoco
# YOCO_SECRET_KEY=replace-with-your-yoco-secret-key
# YOCO_WEBHOOK_SECRET=replace-with-your-yoco-webhook-secret   # starts "whsec_"
#
# Manual EFT (tertiary) needs no env vars — bank details come from
# Admin > Settings > Business details, and an admin marks payments as
# paid by hand once the transfer clears.

# --- Email notifications (optional; logs instead of sending until set) ---
# Point this at Brevo's SMTP relay (smtp-relay.brevo.com:587) or any SMTP
# provider. Quotes, bookings and payments email both the customer and admin.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=replace-with-your-brevo-smtp-login
# SMTP_PASSWORD=replace-with-your-brevo-smtp-key
# EMAIL_FROM=bookings@yourdomain.co.za

# --- Admin auth (required to use /admin) ---
# Shared password for the single admin login at /admin/login. Use a strong,
# unique value in production — this is the only gate in front of the dashboard.
# ADMIN_PASSWORD=replace-with-a-strong-password
#
# Secret used to sign admin session cookies. Generate with: openssl rand -hex 32
# SESSION_SECRET=replace-with-a-long-random-secret

# --- Address autocomplete & distance-based delivery pricing (optional) ---
# Get a free-tier key at https://www.geoapify.com/. Without it, the address
# field still works as plain manual entry and delivery is charged a flat
# base fee (src/lib/pricing.ts) instead of real distance from the depot.
# Server-side only — never exposed to the browser (see src/app/api/geocode).
# GEOAPIFY_API_KEY=replace-with-your-geoapify-key

# --- For external hosting later (Supabase / any Postgres) ---
# The Drizzle schema is standard Postgres, so hosting is a driver swap in src/db/client.ts.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
